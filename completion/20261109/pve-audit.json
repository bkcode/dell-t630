  "forward_guard_files": [
    {
      "path": "/usr/local/sbin/dell-management-forwarding-off",
      "sha256": "96b0b6d8b5bb137a7599f3afe3ff86c1c3a6986b4ecb8cad106ba06fb55a6c05",
      "uid": 0,
      "mode": "0o755",
      "safe_public_source": "#!/bin/sh\n# PVE management/L2 only. Do not restart networking or change routing/ACL.\nset -eu\n[ \"$(hostname -s)\" = pve ] && [ -d /etc/pve ]\nfor family in ipv4 ipv6; do\n    for path in /proc/sys/net/$family/conf/*/forwarding; do\n        [ -f \"$path\" ] || continue\n        printf '0\\n' > \"$path\"\n    done\ndone\nprintf '0\\n' > /proc/sys/net/ipv4/ip_forward\n"
    },
    {
      "path": "/etc/network/if-up.d/dell-management-forwarding-off",
      "sha256": "bda534462bc2b1bb87acfa9ade706dc5604e8b022da1a27b9ab9fcd7a781ae2e",
      "uid": 0,
      "mode": "0o755",
      "safe_public_source": "#!/bin/sh\n# ifupdown2 sets forwarding on bridges with IP; restore original management-only contract.\nset -eu\n[ \"${IFACE:-}\" = vmbr0 ] || exit 0\nexec /usr/local/sbin/dell-management-forwarding-off\n"
    },
    {
      "path": "/etc/sysctl.d/99-z-dell-management-only.conf",
      "sha256": "541cd07b995e8d7d537591bf0cf4a4c6daf8f5f89efa64bd5e18afe95d9f4e97",
      "uid": 0,
      "mode": "0o644",
      "safe_public_source": "net.ipv4.ip_forward=0\nnet.ipv4.conf.all.forwarding=0\nnet.ipv4.conf.default.forwarding=0\nnet.ipv6.conf.all.forwarding=0\nnet.ipv6.conf.default.forwarding=0\n"
    },
    {
      "path": "/etc/systemd/system/dell-network19-bridge.service",
      "sha256": "e543479d9297740e197e41476fe5813eeec0c4dd95d2d4442ee6a6d498bf6cb0",
      "uid": 0,
      "mode": "0o644",
      "safe_public_source": "[Unit]\nDescription=Dell server19 L2 identity and role ACL\nRequires=pve-cluster.service\nAfter=pve-cluster.service network.target\nBefore=pve-guests.service\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/local/sbin/dell-apply-network19-bridge\n[Install]\nWantedBy=multi-user.target\n"
    },
    {
      "path": "/etc/systemd/system/dell-network19-bridge.service.d/20-management-only.conf",
      "sha256": "a42bfddfa94cefa54c44d9daf979b3644f6906f96ca64fb800d5319bfd1c2674",
      "uid": 0,
      "mode": "0o644",
      "safe_public_source": "[Service]\n# Runs after network.target on boot, before pve-guests.service.\nExecStartPost=/usr/local/sbin/dell-management-forwarding-off\n"
    }

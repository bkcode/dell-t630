{
  "uid": "dell-infrastructure",
  "title": "Dell infrastructure — candidate targets require activation",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Guest exporter up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"guest-node\"}",
          "refId": "A",
          "legendFormat": "{{role}} {{check}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "probe_success{job=\"http-health\"}",
          "refId": "A",
          "legendFormat": "{{role}} {{check}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Guest available memory %",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "100 * node_memory_MemAvailable_bytes{job=\"guest-node\"} / node_memory_MemTotal_bytes{job=\"guest-node\"}",
          "refId": "A",
          "legendFormat": "{{role}} {{check}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Guest CPU busy %",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by (role) (rate(node_cpu_seconds_total{job=\"guest-node\",mode=\"idle\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{role}} {{check}}"
        }
      ]
    }
  ]
}
